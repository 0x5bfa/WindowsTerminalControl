<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Configurations>Debug;Release</Configurations>
    <Platforms>x64;arm64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>

    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <ConptyRequiresx64Host>true</ConptyRequiresx64Host>
    <ConptyRequiresARM64Host>true</ConptyRequiresARM64Host>
    
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\WindowsTerminalControl.Core\WindowsTerminalControl.Core.csproj" />
    <ProjectReference Include="..\..\src\WindowsTerminalControl.WinForms\WindowsTerminalControl.WinForms.csproj" />
  </ItemGroup>

</Project>
