<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>

    <UseWindowsForms>true</UseWindowsForms>
    <Configurations>Debug;Release</Configurations>
    <Platforms>x64;arm64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <CsWin32RunAsBuildTask>true</CsWin32RunAsBuildTask>

    <IsPackable>true</IsPackable>
    <PackageId>WindowsTerminalControl.WinForms</PackageId>
    <Description>A WinForms host for the native Windows Terminal renderer.</Description>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CI.Microsoft.Terminal.Wpf" Version="1.25.260303002" GeneratePathProperty="true" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\WindowsTerminalControl.Core\WindowsTerminalControl.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="$(PkgCI_Microsoft_Terminal_Wpf)\runtimes\win-x64\native\Microsoft.Terminal.Control.dll">
      <Link>Microsoft.Terminal.Control.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <Pack>true</Pack>
      <PackagePath>runtimes\win-x64\native</PackagePath>
    </Content>
  </ItemGroup>

</Project>
