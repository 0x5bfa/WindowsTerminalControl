<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>WindowsTerminalControl.Wpf</RootNamespace>
    <AssemblyName>WindowsTerminalControl.Wpf</AssemblyName>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <IsPackable>true</IsPackable>
    <PackageId>WindowsTerminalControl.Wpf</PackageId>
    <Description>A reusable terminal-session connection adapter for the Windows Terminal WPF control.</Description>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CI.Microsoft.Terminal.Wpf" Version="1.25.260303002" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\WindowsTerminalControl.Core\WindowsTerminalControl.Core.csproj" />
  </ItemGroup>

</Project>
