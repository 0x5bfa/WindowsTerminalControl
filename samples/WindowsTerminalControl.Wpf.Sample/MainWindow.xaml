<Window x:Class="WindowsTerminalControl.Samples.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:terminal="clr-namespace:Microsoft.Terminal.Wpf;assembly=Microsoft.Terminal.Wpf"
        Title="Windows Terminal control — WPF"
        Width="1100"
        Height="700"
        MinWidth="640"
        MinHeight="400"
        WindowStartupLocation="CenterScreen">
    <Grid Background="#0C0C0C">
        <terminal:TerminalControl x:Name="Terminal" AutoResize="True" />
    </Grid>
</Window>
