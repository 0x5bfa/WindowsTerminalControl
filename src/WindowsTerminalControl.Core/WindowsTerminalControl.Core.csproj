<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Configurations>Debug;Release</Configurations>
    <Platforms>x64;arm64</Platforms>

    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <ConptyRequiresx64Host>true</ConptyRequiresx64Host>
    <ConptyRequiresARM64Host>true</ConptyRequiresARM64Host>

    <IsPackable>true</IsPackable>
    <PackageId>WindowsTerminalControl.Core</PackageId>
    <Description>Transport abstractions and a local ConPTY session for Windows Terminal controls.</Description>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.Console.ConPTY" Version="1.25.260710002-preview" />
  </ItemGroup>

</Project>
