<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>

    <UseWPF>true</UseWPF>
    <Configurations>Debug;Release</Configurations>
    <Platforms>x64;arm64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <CsWin32RunAsBuildTask>true</CsWin32RunAsBuildTask>

    <IsPackable>true</IsPackable>
    <PackageId>WindowsTerminalControl.Wpf</PackageId>
    <Description>A reusable terminal-session connection adapter for the Windows Terminal WPF control.</Description>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CI.Microsoft.Terminal.Wpf" Version="1.25.260303002" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\WindowsTerminalControl.Core\WindowsTerminalControl.Core.csproj" />
  </ItemGroup>

</Project>
