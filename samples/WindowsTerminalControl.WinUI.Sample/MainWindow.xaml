<Window
    x:Class="WindowsTerminalControl.Samples.WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Windows Terminal control — WinUI 3">

    <Grid Background="#0C0C0C">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition />
        </Grid.RowDefinitions>

        <Border
            x:Name="HostToolbar"
            Padding="12,8"
            Background="#202020"
            BorderBrush="#3A3A3A"
            BorderThickness="0,0,0,1">
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>

                <ComboBox
                    x:Name="HostModePicker"
                    HorizontalAlignment="Stretch"
                    SelectedIndex="0">
                    <ComboBoxItem Content="Composition" Tag="Composition" />
                    <ComboBoxItem Content="Child HWND" Tag="Hwnd" />
                </ComboBox>

                <!--<Button
                    x:Name="CopyButton"
                    Grid.Column="1"
                    Click="OnCopyClicked"
                    Content="Copy" />
                <Button
                    x:Name="PasteButton"
                    Grid.Column="2"
                    Click="OnPasteClicked"
                    Content="Paste" />
                <TextBlock
                    x:Name="StatusText"
                    Grid.Column="3"
                    Margin="8,0,0,0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Foreground="#C8C8C8"
                    TextTrimming="CharacterEllipsis" />-->
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <ContentControl
                x:Name="TerminalHost"
                HorizontalContentAlignment="Stretch"
                VerticalContentAlignment="Stretch" />

            <Border
                Margin="16"
                Padding="9,5"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Background="#CC2D2D30"
                CornerRadius="4"
                IsHitTestVisible="False">
                <TextBlock Foreground="White" Text="Here's XAML overlay!" />
            </Border>
        </Grid>
    </Grid>
</Window>
